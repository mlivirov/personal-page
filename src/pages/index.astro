---
import Base from '../layouts/Base.astro';
import { profile, services, projects, experience, faq, techStack } from '../data/profile';

const year = new Date().getFullYear();
const mailto = `mailto:${profile.email}`;

// House typography: glue short words to the next one and keep dashes off line starts,
// so no line ever ends on "a", "to" or "of".
const typo = (t: string) =>
  t
    .replace(/(^|\s)([A-Za-z]{1,3}|[0-9]+[×+]?)\s/g, '$1$2 ')
    .replace(/\s—/g, ' —')
    .replace(/(\d)\s?–\s?(\d|Present)/g, '$1–$2');

const slug = (t: string) => t.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');

// Portfolio "thumbnails": flat colour posters with a typographic mark and a joke in the tooltip.
const tiles = [
  { bg: '#ebe6dc', fg: '#111', mark: 'GRC', small: 'FedRAMP · NIST', joke: 'Compliance, but make it fast' },
  { bg: '#d7263d', fg: '#fff', mark: '↻', small: 'monthly · annually', joke: 'Every month, on schedule. Even in February.' },
  { bg: '#111', fg: '#fff', mark: '10×', small: 'response time', joke: 'Same servers. Different attitude.' },
  { bg: '#ffd400', fg: '#111', mark: 'TB', small: 'hundreds of them', joke: 'Rows were counted. It took a while.' },
  { bg: '#1b4dff', fg: '#fff', mark: 'T−0', small: 'Antares · RTOS', joke: 'Literally rocket science' },
];

const cases = projects.map((p, i) => ({ ...p, id: slug(p.title), tile: tiles[i % tiles.length], n: i + 1 }));
---

<Base>
  <div class="page">
    <header>
      <a href="#top" class="logo" title="That’s me">max livirov</a>
      <nav>
        <a href="#portfolio">Portfolio</a>
        <a href="#services">Services</a>
        <a href="#stack">Stack</a>
        <a href="#experience">Experience</a>
        <a href="#questions">Questions</a>
      </nav>
      <a class="order" href={mailto} title="Opens your mail client. Nothing scary.">Hire me</a>
    </header>

    <main id="top">
    <section class="hero">
      <h1 set:html={typo('Max Livirov designs and builds .NET backends that keep working when nobody is looking.<sup>1</sup>')} />
      <p class="aside">
        Freelance. Remote. Fifteen years in FinTech, insurance, security and GovTech.
      </p>
      <p class="footnote"><sup>1</sup> Including weekends, holidays and the night before a release.</p>
    </section>

    <section id="portfolio">
      <h2 class="label">Portfolio <span class="grey">{cases.length} projects</span></h2>
        <div class="portfolio">
          {
            cases.map((c) => (
              <a class="item" href={`#${c.id}`} title={c.tile.joke}>
                <div class="thumb" style={`background:${c.tile.bg};color:${c.tile.fg}`}>
                  <span class="mark">{c.tile.mark}</span>
                  <span class="mini">{c.tile.small}</span>
                </div>
                <h3 set:html={typo(c.title)} />
                <p class="grey">
                  {c.client}, <span class="nowrap">{c.year}</span>
                </p>
              </a>
            ))
          }
        </div>
    </section>

    <section class="cases">
      {
        cases.map((c, i) => (
          <article id={c.id} class="case" data-case>
            <div class="case-thumb" style={`background:${c.tile.bg};color:${c.tile.fg}`}>
              {c.tile.mark}
            </div>
            <div class="case-body">
              <p class="grey small">
                Project {c.n} of {cases.length} · {c.client}, {c.year}
              </p>
              <h2 set:html={typo(c.title)} />
              <dl>
                <dt>Task</dt>
                <dd set:html={typo(c.problem)} />
                <dt>Solution</dt>
                <dd set:html={typo(c.solution)} />
                <dt>Result</dt>
                <dd class="result" set:html={typo(c.result)} />
                <dt>Stack</dt>
                <dd class="grey">{c.stack.join(', ')}</dd>
              </dl>
              <p class="pager">
                {i > 0 ? <a href={`#${cases[i - 1].id}`}>← previous</a> : <span class="grey">← previous</span>}
                <kbd>Ctrl</kbd>
                {i < cases.length - 1 ? <a href={`#${cases[i + 1].id}`}>next →</a> : <span class="grey">next →</span>}
              </p>
            </div>
          </article>
        ))
      }
    </section>

    <section id="services">
      <h2 class="label">What I can do for you</h2>
      <div class="offers">
        {
          services.map((s, i) => (
            <div class="offer">
              <span class="sect">§&nbsp;{i + 1}</span>
              <h3>
                <a href={mailto} title="Yes, this one">
                  {s.title}
                </a>
              </h3>
              <p set:html={typo(s.body)} />
              <p class="grey small">{s.tags.join(', ')}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section id="stack">
      <h2 class="label">Tech stack</h2>
      <dl class="stack">
        {
          techStack.map((g) => (
            <div class="stack-row">
              <dt>{g.group}</dt>
              <dd>
                {g.items.map((t, i) => (
                  <>
                    <span title={t.aliases?.length ? `Also known as ${t.aliases.join(', ')}` : undefined}>{t.name}</span>
                    {i < g.items.length - 1 && ', '}
                  </>
                ))}
              </dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section id="experience" class="two-col">
      <h2 class="label">Experience</h2>
      <table>
        {
          experience.map((e) => (
            <tr>
              <td class="grey nowrap num">{e.period.replace(' – ', '–')}</td>
              <td>
                <b>{e.company}</b>
                <br />
                <span class="grey">
                  {e.role}, {e.type.toLowerCase()}
                </span>
              </td>
            </tr>
          ))
        }
      </table>
    </section>

    <section id="questions" class="two-col">
      <h2 class="label">Questions</h2>
      <dl class="faq">
        {
          faq.map((f) => (
            <>
              <dt set:html={typo(f.q)} />
              <dd set:html={typo(f.a)} />
            </>
          ))
        }
      </dl>
    </section>

    <section class="cta">
      <p>
        Email me: <a href={mailto}>{profile.email}</a>
      </p>
      <p class="grey">Replies within one business day. Signs your NDA before the first call.</p>
    </section>

    </main>

    <footer>
      <span>© 2009–{year} Max Livirov</span>
      <span class="hint grey">
        <kbd>Ctrl</kbd> + <kbd>←</kbd> <kbd>→</kbd> to flip through projects
      </span>
      <span class="links">
        {profile.socials.map((s) => <a href={s.url}>{s.label}</a>)}
      </span>
    </footer>
  </div>
</Base>

<script>
  // Deep links (/#stack): web fonts load after the browser's initial jump and shift the layout, so re-align once they're ready.
  if (location.hash) {
    document.fonts.ready.then(() => document.querySelector(location.hash)?.scrollIntoView({ block: 'start' }));
  }

  // Ctrl + ←/→ flips between projects, like the portfolio pages this design borrows from.
  const cases = [...document.querySelectorAll<HTMLElement>('[data-case]')];
  // Index of the case scrolled to (its top has reached the top of the screen), or -1 above the first one.
  const current = () => cases.findLastIndex((c) => c.getBoundingClientRect().top <= 40);
  addEventListener('keydown', (e) => {
    if (!e.ctrlKey || !['ArrowLeft', 'ArrowRight'].includes(e.key)) return;
    if ((e.target as HTMLElement).closest('input, textarea')) return;
    e.preventDefault();
    const i = current() + (e.key === 'ArrowRight' ? 1 : -1);
    cases[Math.max(0, Math.min(cases.length - 1, i))].scrollIntoView({ behavior: 'smooth', block: 'start' });
  });
</script>
